%% Do we log or enforce
{mapping, "seven_state_classic_b_gone.enforcement_mode", "seven_state_classic_b_gone.mode", [
    {datatype, {enum, [log, enforce]}},
    {validators, []}]}.

%% log log level
{mapping, "seven_state_classic_b_gone.log_mode_log_level", "seven_state_classic_b_gone.log_level", [
    {datatype, {enum, [debug, info, warning, error]}},
    {validators, []}]}.

%% enforcement log level
{mapping, "seven_state_classic_b_gone.enforce_mode_log_level", "seven_state_classic_b_gone.enforce_log_level", [
    {datatype, {enum, [debug, info, warning, error]}},
    {validators, []}]}.

%% disable exclusive classic queues
{mapping, "seven_state_classic_b_gone.disable_exclusive_queues", "seven_state_classic_b_gone.exclusive", [
    {datatype, {enum, [true, false]}},
    {validators, []}]}.

%% disable existing queues declare
{mapping, "seven_state_classic_b_gone.disable_existing_queues", "seven_state_classic_b_gone.existing", [
    {datatype, {enum, [true, false]}},
    {validators, []}]}.

%% let passive declare through
{mapping, "seven_state_classic_b_gone.always_let_passive_declare", "seven_state_classic_b_gone.passive", [
    {datatype, {enum, [true, false]}},
    {validators, []}]}.

%% check the policies to let classic non-ha through
{mapping, "seven_state_classic_b_gone.inspect_policies", "seven_state_classic_b_gone.policies", [
    {datatype, {enum, [true, false]}},
    {validators, []}]}.

%% log message: existing queues
{mapping, "seven_state_classic_b_gone.existing_queue_log_message", "seven_state_classic_b_gone.existing_queue_log", [
    {datatype, string},
    {validators, []}]}.

%% log message: allowed queue type
{mapping, "seven_state_classic_b_gone.allowed_queue_type_log_message", "seven_state_classic_b_gone.allowed_queue_type_log", [
    {datatype, string},
    {validators, []}]}.

%% log message: passive declare
{mapping, "seven_state_classic_b_gone.passive_declare_log_message", "seven_state_classic_b_gone.passive_declare_log", [
    {datatype, string},
    {validators, []}]}.

%% log message: new declare blocked when mode =:= log
{mapping, "seven_state_classic_b_gone.new_queue_log_message", "seven_state_classic_b_gone.new_queue_log", [
    {datatype, string},
    {validators, []}]}.

%% log message: new declare blocked when mode =:= enforce
{mapping, "seven_state_classic_b_gone.new_queue_log_enforce_message", "seven_state_classic_b_gone.new_queue_enforce", [
    {datatype, string},
    {validators, []}]}.

%% log message: declare classic mirrored disabled
{mapping, "seven_state_classic_b_gone.classic_mirrored_queues_disabled_log", "seven_state_classic_b_gone.classic_mirrored_queues_disabled_log", [
    {datatype, string},
    {validators, []}]}.

%% log message: declare all classic disabled
{mapping, "seven_state_classic_b_gone.all_classic_queues_disabled_log", "seven_state_classic_b_gone.all_classic_queues_disabled_log", [
    {datatype, string},
    {validators, []}]}.

%% log message: declare exclusive classic disabled
{mapping, "seven_state_classic_b_gone.exclusive_queues_disabled_log", "seven_state_classic_b_gone.exclusive_queues_disabled_log", [
    {datatype, string},
    {validators, []}]}.

%% AMQP error: declare classic mirrored disabled
{mapping, "seven_state_classic_b_gone.amqp_error_classic_mirrored_queues_disabled_message", "seven_state_classic_b_gone.classic_mirrored_queues_disabled_error", [
    {datatype, string},
    {validators, []}]}.

%% AMQP error: declare all classic disabled
{mapping, "seven_state_classic_b_gone.amqp_error_all_classic_queues_disabled_message", "seven_state_classic_b_gone.all_classic_queues_disabled_error", [
    {datatype, string},
    {validators, []}]}.

%% AMQP error: declare exclusive classic disabled
{mapping, "seven_state_classic_b_gone.amqp_error_exclusive_queues_disabled_message", "seven_state_classic_b_gone.exclusive_queues_disabled_error", [
    {datatype, string},
    {validators, []}]}.
